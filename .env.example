# Service principal credentials for the official Power BI REST API
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=

# Optional: only needed for the best-effort undocumented Audiences path.
# Obtain by opening a Power BI App in Chrome, opening DevTools > Network,
# finding a request to wabi-*.analysis.windows.net, and copying its
# Authorization header value. Expires and must be refreshed manually.
POWERBI_BROWSER_TOKEN=
